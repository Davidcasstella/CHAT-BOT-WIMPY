# =============================================================================
# Variables de entorno para WhatsApp Bot Wimpy
# =============================================================================
# Copia este archivo a .env y configura tus valores
# cp .env.example .env
# =============================================================================

# Entorno de ejecución (development | production)
NODE_ENV=production

# Puerto del servidor (por defecto 3000)
PORT=3000

# Configuración opcional para logging
LOG_LEVEL=info

# =============================================================================
# NOTA: La configuración principal del bot está en bot-config.json
# Incluye: nombre empresa, teléfono, dirección, cooldown, mensajes, etc.
# =============================================================================
